<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\..\Rules.ruleset</CodeAnalysisRuleSet>
    <Version>1.0.0</Version>
    <Copyright>Copyright © 2026</Copyright>
    <PackageProjectUrl>https://github.com/NikolayIT/SantaseGameEngine</PackageProjectUrl>
    <Authors>Claude</Authors>
    <RepositoryUrl>https://github.com/NikolayIT/SantaseGameEngine</RepositoryUrl>
    <Product>SantaseGameEngine</Product>
    <PackageId>SantaseGameEngine.ClaudePlayer</PackageId>
    <Description>The strongest Santase (66) bots for SantaseGameEngine: ClaudePlayer (hand-tuned heuristics with an exact endgame solver), ClaudePlayerNeural (a small built-in neural network, pure managed code) and ClaudePlayerIsmcts (information set Monte Carlo tree search). All can decide from a seat view (IRestorablePlayer).</Description>
    <PackageTags>Santase, 66, Сантасе, Sixty-six, Schnapsen, card game, AI, bot</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>GitHub</RepositoryType>
    <PackageIcon>Logo_300x300.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\..\stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\assets\Logo_300x300.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Santase.Logic\Santase.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Neural\weights.bin" LogicalName="Santase.AI.ClaudePlayer.Neural.weights.bin" />
  </ItemGroup>

</Project>
